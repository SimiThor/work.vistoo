<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light appearance only, like the web and iOS (tokens define no dark palette). -->
    <style name="Theme.Vistoo" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/vistoo_surface_subtle</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="Theme.Vistoo.Starting" parent="Theme.Vistoo" />
</resources>
