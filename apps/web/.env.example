# Copy to .env.local and fill in. Never commit real values.

# --- Supabase (Project Settings → API) -------------------------------------
# Public: safe for the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server only: needed to send invitation e-mails (auth admin API). Never expose.
SUPABASE_SECRET_KEY=sb_secret_xxx

# --- Database (Project Settings → Database → Connection string) -----------
# Runtime (Vercel): transaction pooler, port 6543.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# Migrations: session pooler (5432) or direct connection. Falls back to DATABASE_URL.
DIRECT_DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# --- App ------------------------------------------------------------------
# Absolute URL of this app; used for e-mail redirect links.
# On Vercel, VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL are used if unset.
SITE_URL=http://localhost:3100

# --- Tests (optional) -------------------------------------------------------
# Disposable Postgres server for integration tests (database vistoo_test is recreated!).
# TEST_DATABASE_ADMIN_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres

# --- Chat (optional) --------------------------------------------------------
# Secret for the daily Vercel Cron that cleans up chat files (/api/cron/chat-cleanup).
# CRON_SECRET=generate-a-long-random-string
# Chat file budget per workspace in MB (default 500). Lowered automatically if
# the project's storage quota (STORAGE_QUOTA_MB, default 1024 = Free plan) is tight.
# CHAT_STORAGE_BUDGET_MB=500
# STORAGE_QUOTA_MB=1024
