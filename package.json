{
  "name": "vistoo-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @vistoo/web",
    "build": "npm run build -w @vistoo/web",
    "start": "npm run start -w @vistoo/web",
    "lint": "npm run lint -w @vistoo/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:backend": "npm run test -w @vistoo/backend",
    "test:e2e": "npm run test:e2e -w @vistoo/web",
    "generate": "npm run generate -w @vistoo/contracts && npm run generate -w @vistoo/design-tokens",
    "generate:check": "npm run generate && git diff --exit-code -- packages/contracts/generated apps/ios/Packages/VistooKit/Sources/VistooCore/Generated apps/ios/Packages/VistooKit/Sources/VistooUI/Generated apps/web/src/app/tokens.generated.css",
    "db:generate": "npm run db:generate -w @vistoo/database --",
    "db:migrate": "npm run db:migrate -w @vistoo/database",
    "db:seed": "npm run db:seed -w @vistoo/database",
    "bootstrap:admin": "npm run bootstrap:admin -w @vistoo/database --",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "ios:generate-project": "cd apps/ios && xcodegen generate",
    "ios:test-kit": "sh apps/ios/scripts/test-kit.sh",
    "check": "npm run generate:check && npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^20",
    "dotenv": "^18.0.9",
    "supabase": "^2.121.0",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.9"
  }
}
