{
  "$comment": "Shared conformance cases for task filtering. Run by packages/domain (TypeScript) and apps/ios VistooCoreTests (Swift). Values within a filter are OR-ed, different filters AND-ed; search matches the title case-insensitively.",
  "tasks": [
    { "id": "t1", "title": "Angebot für Müller GmbH", "projectId": "p1", "groupId": "g1", "assigneeId": "u1", "status": "open" },
    { "id": "t2", "title": "ÜBERARBEITUNG Logo", "projectId": "p1", "groupId": null, "assigneeId": null, "status": "in_progress" },
    { "id": "t3", "title": "Release vorbereiten", "projectId": "p2", "groupId": "g2", "assigneeId": "u2", "status": "in_review" },
    { "id": "t4", "title": "Rechnung prüfen", "projectId": "p2", "groupId": null, "assigneeId": "u1", "status": "done" },
    { "id": "t5", "title": "Neuer Status aus der Zukunft", "projectId": "p1", "groupId": null, "assigneeId": null, "status": "blocked" }
  ],
  "cases": [
    { "name": "no filters", "filters": {}, "expected": ["t1", "t2", "t3", "t4", "t5"] },
    { "name": "search is case-insensitive incl. umlauts", "filters": { "q": "überarbeitung" }, "expected": ["t2"] },
    { "name": "search ignores surrounding whitespace", "filters": { "q": "  müller " }, "expected": ["t1"] },
    { "name": "search matches substrings of the title only", "filters": { "q": "p2" }, "expected": [] },
    { "name": "project filter", "filters": { "projects": ["p2"] }, "expected": ["t3", "t4"] },
    { "name": "values within a filter are OR-ed", "filters": { "statuses": ["open", "done"] }, "expected": ["t1", "t4"] },
    { "name": "different filters are AND-ed", "filters": { "projects": ["p1"], "assignees": ["u1"] }, "expected": ["t1"] },
    { "name": "unassigned", "filters": { "assignees": ["none"] }, "expected": ["t2", "t5"] },
    { "name": "unassigned or a person", "filters": { "assignees": ["none", "u2"] }, "expected": ["t2", "t3", "t5"] },
    { "name": "no group", "filters": { "groups": ["none"] }, "expected": ["t2", "t4", "t5"] },
    { "name": "group or no group", "filters": { "groups": ["g1", "none"] }, "expected": ["t1", "t2", "t4", "t5"] },
    { "name": "unknown status values only match themselves", "filters": { "statuses": ["in_progress"] }, "expected": ["t2"] },
    { "name": "combined with search", "filters": { "q": "re", "projects": ["p2"], "statuses": ["in_review", "done"] }, "expected": ["t3", "t4"] }
  ]
}
