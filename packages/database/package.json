{
  "name": "@vistoo/database",
  "version": "0.1.0",
  "private": true,
  "description": "Single source of truth for the Postgres schema (Drizzle) and the migration chain (incl. RLS, triggers, realtime publication, storage bucket).",
  "exports": {
    "./schema": "./src/schema.ts",
    "./tls": "./src/tls.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx scripts/seed.ts",
    "bootstrap:admin": "tsx scripts/bootstrap-admin.ts"
  },
  "dependencies": {
    "@vistoo/domain": "*",
    "drizzle-orm": "^0.45.4",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15"
  }
}
