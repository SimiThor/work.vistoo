{
  "$description": "Vistoo design tokens. Calm, neutral, Apple-inspired: one accent colour (blue) for interaction; status colours are always paired with a shape and a text label. Light appearance only (same decision as the web MVP). Edit here, then run `npm run generate` → apps/web/src/app/tokens.generated.css and apps/ios/.../VistooUI/Generated/DesignTokens.swift. Platform-specific values go into `overrides` — never change a base value to fix one platform.",

  "color": {
    "background":        { "value": "#ffffff", "description": "Page and card background" },
    "surface-subtle":    { "value": "#f5f5f7", "description": "Sidebar, board columns, grouped backgrounds" },
    "surface-sunken":    { "value": "#ececf0", "description": "Hover/pressed on subtle surfaces" },
    "foreground":        { "value": "#1d1d1f", "description": "Primary text" },
    "muted-foreground":  { "value": "#6e6e73", "description": "Secondary text (5.0:1 on white)" },
    "border":            { "value": "#e3e3e8" },
    "border-strong":     { "value": "#d1d1d6" },
    "input":             { "value": "#d1d1d6" },
    "accent-blue":       { "value": "#0071e3", "description": "Interaction accent (4.7:1 with white text)" },
    "accent-blue-hover": { "value": "#0062c4" },
    "accent-blue-soft":  { "value": "#e8f1fc", "description": "Selected / in-progress backgrounds" },
    "accent-blue-text":  { "value": "#0058b0", "description": "Accent as text on white (6.6:1)" },
    "status-open":       { "value": "#8e8e93", "description": "Status icon colour; text stays neutral" },
    "status-progress":   { "value": "#0071e3" },
    "status-review":     { "value": "#b86e00" },
    "status-done":       { "value": "#248a3d" },
    "destructive":       { "value": "#d70015" },
    "warning-bg":        { "value": "#fff6e5" },
    "warning-fg":        { "value": "#7a4a00" },
    "timeline-open-bg":      { "value": "#f0f1f4", "description": "Timeline bar fill per status" },
    "timeline-open-border":  { "value": "#d6d8de" },
    "timeline-review-bg":    { "value": "#fbf2e3" },
    "timeline-review-border":{ "value": "#ead3ab" },
    "timeline-progress-border": { "value": "#b9d3f3" }
  },

  "radius": {
    "base": { "value": 8, "description": "px/pt. Web derives sm/md/lg/xl from --radius; iOS uses the named steps." },
    "sm":   { "value": 4 },
    "md":   { "value": 6 },
    "lg":   { "value": 8 },
    "xl":   { "value": 12 }
  },

  "spacing": {
    "$description": "4-pt grid. Web: Tailwind's spacing scale (1 = 4px) is equivalent; these names are used by iOS.",
    "xxs": { "value": 2 },
    "xs":  { "value": 4 },
    "sm":  { "value": 8 },
    "md":  { "value": 12 },
    "lg":  { "value": 16 },
    "xl":  { "value": 24 },
    "xxl": { "value": 32 }
  },

  "shadow": {
    "card":    { "web": "0 1px 1px rgb(0 0 0 / 0.03), 0 1px 3px rgb(0 0 0 / 0.04)", "ios": { "opacity": 0.06, "radius": 2, "y": 1 } },
    "raised":  { "web": "0 8px 24px rgb(0 0 0 / 0.1), 0 0 0 1px rgb(0 0 0 / 0.04)", "ios": { "opacity": 0.1, "radius": 12, "y": 4 } },
    "overlay": { "web": "0 16px 48px rgb(0 0 0 / 0.14), 0 0 0 1px rgb(0 0 0 / 0.05)", "ios": { "opacity": 0.14, "radius": 24, "y": 8 } }
  },

  "typography": {
    "$description": "Semantic roles. Web: compact tool scale (rem). iOS: Dynamic Type text styles (scale with the user's text size); body is deliberately larger on iOS for touch readability.",
    "page-title":    { "web": { "size": "1.375rem", "lineHeight": "1.75rem", "tailwind": "xl" },   "ios": { "style": "title2", "weight": "semibold" } },
    "section-title": { "web": { "size": "1.0625rem", "lineHeight": "1.5rem", "tailwind": "lg" },  "ios": { "style": "headline", "weight": "semibold" } },
    "body":          { "web": { "size": "0.875rem", "lineHeight": "1.375rem", "tailwind": "base" }, "ios": { "style": "body", "weight": "regular" } },
    "dense":         { "web": { "size": "0.8125rem", "lineHeight": "1.25rem", "tailwind": "sm" },  "ios": { "style": "subheadline", "weight": "regular" } },
    "caption":       { "web": { "size": "0.75rem", "lineHeight": "1rem", "tailwind": "xs" },        "ios": { "style": "caption", "weight": "regular" } }
  },

  "overrides": {
    "$description": "Explicit platform overrides. Only the named platform changes.",
    "ios": {
      "color": {
        "surface-subtle": { "value": "#f2f2f7", "reason": "Matches iOS grouped list backgrounds (systemGroupedBackground) so native lists and custom surfaces blend." }
      },
      "radius": {
        "lg": { "value": 10, "reason": "Touch-sized cards and buttons read better with slightly rounder corners on iPhone." }
      }
    },
    "web": {}
  }
}
