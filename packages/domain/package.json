{
  "name": "@vistoo/domain",
  "version": "0.1.0",
  "private": true,
  "description": "Isomorphic domain rules: constants, DTO schemas, input validation, calendar dates. Used by web (client + server) and the backend; source of the API contract.",
  "sideEffects": false,
  "exports": {
    ".": "./src/domain.ts",
    "./validation": "./src/validation.ts",
    "./chat-config": "./src/chat-config.ts",
    "./chat-types": "./src/chat-types.ts",
    "./mentions": "./src/mentions.ts",
    "./issue-refs": "./src/issue-refs.ts",
    "./dates": "./src/dates.ts",
    "./result": "./src/result.ts",
    "./dto": "./src/dto.ts",
    "./filters": "./src/filters.ts",
    "./links": "./src/links.ts",
    "./todos": "./src/todos.ts",
    "./ideas": "./src/ideas.ts",
    "./crm": "./src/crm.ts",
    "./markdown": "./src/markdown.ts",
    "./decisions": "./src/decisions.ts",
    "./meetings": "./src/meetings.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run"
  },
  "dependencies": {
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "vitest": "^4.1.12"
  }
}
